{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speaksharp-public.vercel.app/evidence/model-downselection.schema.json",
  "title": "SpeakSharp Production model downselection evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "environment",
    "geminiContract",
    "telemetryReadback",
    "candidateEvidence",
    "geminiEvidence",
    "selection"
  ],
  "properties": {
    "schemaVersion": { "const": "speaksharp.model-downselection.v1" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "releaseSha"],
      "properties": {
        "origin": { "const": "https://speaksharp-public.vercel.app" },
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "geminiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "uncachedRequestsPerUserUtcDay",
        "quotaScope",
        "whatWorkedItems",
        "whatToImproveItems",
        "maxWhitespaceWordsPerPhrase",
        "cachedResultsReadable"
      ],
      "properties": {
        "model": { "const": "gemini-3.6-flash" },
        "uncachedRequestsPerUserUtcDay": { "const": 10 },
        "quotaScope": { "const": "user_utc_day" },
        "whatWorkedItems": { "const": 1 },
        "whatToImproveItems": { "const": 1 },
        "maxWhitespaceWordsPerPhrase": { "const": 6 },
        "cachedResultsReadable": { "const": true }
      }
    },
    "telemetryReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "queryId", "decodedAt", "positiveControlNonce", "events"],
      "properties": {
        "source": { "const": "posthog_decoded_readback" },
        "queryId": { "$ref": "#/$defs/token" },
        "decodedAt": { "type": "string", "format": "date-time" },
        "positiveControlNonce": { "$ref": "#/$defs/token" },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/telemetryEvent" }
        }
      }
    },
    "candidateEvidence": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/candidateTake" }
    },
    "geminiEvidence": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/geminiObservation" }
    },
    "selection": { "$ref": "#/$defs/selection" }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate": {
      "enum": ["v2:base.en", "v4:distil:q4", "moonshine:streaming-medium"]
    },
    "telemetryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid", "event", "releaseSha", "candidateId", "journeyId", "attemptId",
        "attemptSeq", "wordCount", "controlNonce", "transportInitialized"
      ],
      "properties": {
        "uuid": { "$ref": "#/$defs/token" },
        "event": { "$ref": "#/$defs/token" },
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidateId": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "journeyId": { "$ref": "#/$defs/token" },
        "attemptId": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "attemptSeq": { "type": "integer", "minimum": 0 },
        "wordCount": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "controlNonce": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "transportInitialized": { "type": ["boolean", "null"] }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict", "holdKind", "dryRun", "targetOrigin", "releaseSha", "expectedCandidate",
        "requestedCandidate", "observedCandidate", "capturedAt", "receiptSha256"
      ],
      "properties": {
        "verdict": { "const": "PASS" },
        "holdKind": { "type": "null" },
        "dryRun": { "const": false },
        "targetOrigin": { "const": "https://speaksharp-public.vercel.app" },
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "expectedCandidate": { "$ref": "#/$defs/candidate" },
        "requestedCandidate": { "$ref": "#/$defs/candidate" },
        "observedCandidate": { "$ref": "#/$defs/candidate" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "receiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "candidateTake": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateId", "journey", "journeyId", "attemptId", "attemptSeq", "receipt"],
      "properties": {
        "candidateId": { "$ref": "#/$defs/candidate" },
        "journey": { "enum": ["open_mic", "focus_points"] },
        "journeyId": { "$ref": "#/$defs/token" },
        "attemptId": { "$ref": "#/$defs/token" },
        "attemptSeq": { "type": "integer", "minimum": 1 },
        "receipt": { "$ref": "#/$defs/receipt" }
      }
    },
    "outputShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whatWorkedItems", "whatToImproveItems", "whatWorkedWhitespaceWords",
        "whatToImproveWhitespaceWords", "readable", "suggestionDigest"
      ],
      "properties": {
        "whatWorkedItems": { "const": 1 },
        "whatToImproveItems": { "const": 1 },
        "whatWorkedWhitespaceWords": { "type": "integer", "minimum": 1, "maximum": 6 },
        "whatToImproveWhitespaceWords": { "type": "integer", "minimum": 1, "maximum": 6 },
        "readable": { "const": true },
        "suggestionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "userDigest", "utcDate", "limit", "requestNumber"],
      "properties": {
        "scope": { "const": "user_utc_day" },
        "userDigest": { "$ref": "#/$defs/sha256" },
        "utcDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "limit": { "const": 10 },
        "requestNumber": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "geminiObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["takeKey", "source", "model", "providerRequestMade", "quota", "output"],
      "properties": {
        "takeKey": { "type": "string" },
        "source": { "enum": ["fresh", "cached"] },
        "model": { "const": "gemini-3.6-flash" },
        "providerRequestMade": { "type": "boolean" },
        "quota": { "anyOf": [{ "$ref": "#/$defs/quota" }, { "type": "null" }] },
        "output": { "$ref": "#/$defs/outputShape" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "primary", "fallback", "sitsOut", "decidedBy", "decidedAt", "decisionEvidenceDigest"
      ],
      "properties": {
        "status": { "enum": ["pending_po_test", "selected"] },
        "primary": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "fallback": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "sitsOut": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "decidedBy": { "enum": ["product_owner", null] },
        "decidedAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] },
        "decisionEvidenceDigest": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
