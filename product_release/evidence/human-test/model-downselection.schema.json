{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://speaksharp-public.vercel.app/evidence/model-downselection.schema.json",
  "title": "SpeakSharp Production model downselection evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceDocumentId",
    "environment",
    "geminiContract",
    "telemetryReadback",
    "candidateEvidence",
    "geminiEvidence",
    "selection"
  ],
  "properties": {
    "schemaVersion": { "const": "speaksharp.model-downselection.v1" },
    "evidenceDocumentId": { "$ref": "#/$defs/uuidv4" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "releaseSha"],
      "properties": {
        "origin": { "const": "https://speaksharp-public.vercel.app" },
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "geminiContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "uncachedRequestsPerUserUtcDay",
        "quotaScope",
        "whatWorkedItems",
        "whatToImproveItems",
        "maxWhitespaceWordsPerPhrase",
        "cachedResultsReadable"
      ],
      "properties": {
        "model": { "const": "gemini-3.6-flash" },
        "uncachedRequestsPerUserUtcDay": { "const": 10 },
        "quotaScope": { "const": "user_utc_day" },
        "whatWorkedItems": { "const": 1 },
        "whatToImproveItems": { "const": 1 },
        "maxWhitespaceWordsPerPhrase": { "const": 6 },
        "cachedResultsReadable": { "const": true }
      }
    },
    "telemetryReadback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "queryId", "decodedAt", "positiveControlNonce", "events"],
      "properties": {
        "source": { "const": "posthog_decoded_readback" },
        "queryId": { "$ref": "#/$defs/token" },
        "decodedAt": { "type": "string", "format": "date-time" },
        "positiveControlNonce": { "$ref": "#/$defs/token" },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/telemetryEvent" }
        }
      }
    },
    "candidateEvidence": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/candidateTake" }
    },
    "geminiEvidence": {
      "type": "array",
      "minItems": 5,
      "items": { "$ref": "#/$defs/geminiObservation" }
    },
    "selection": { "$ref": "#/$defs/selection" }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "uuidv4": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate": {
      "enum": ["v2:base.en", "v4:distil:q4"]
    },
    "telemetryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid", "event", "releaseSha", "candidateId", "productMode", "journeyId", "attemptId",
        "attemptSeq", "wordCount", "comparisonNonce", "controlNonce", "transportInitialized",
        "evidenceDocumentId", "sessionBindingSha256", "evaluatorVersion", "pointsSupplied",
        "pointsEvaluated", "coveredThreshold", "partialThreshold", "pointPosition", "verdict",
        "matchRatio", "keywordCount", "latched", "step", "pointsEntered"
      ],
      "properties": {
        "uuid": { "$ref": "#/$defs/token" },
        "event": { "$ref": "#/$defs/token" },
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidateId": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "productMode": { "anyOf": [{ "enum": ["quick", "objective"] }, { "type": "null" }] },
        "journeyId": { "$ref": "#/$defs/token" },
        "attemptId": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "attemptSeq": { "type": "integer", "minimum": 0 },
        "wordCount": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
        "comparisonNonce": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "controlNonce": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "transportInitialized": { "type": ["boolean", "null"] },
        "evidenceDocumentId": { "anyOf": [{ "$ref": "#/$defs/uuidv4" }, { "type": "null" }] },
        "sessionBindingSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "evaluatorVersion": { "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }] },
        "pointsSupplied": { "type": ["integer", "null"], "minimum": 0 },
        "pointsEvaluated": { "type": ["integer", "null"], "minimum": 0 },
        "coveredThreshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "partialThreshold": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "pointPosition": { "type": ["integer", "null"], "minimum": 0 },
        "verdict": { "anyOf": [{ "$ref": "#/$defs/coverageVerdict" }, { "type": "null" }] },
        "matchRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "keywordCount": { "type": ["integer", "null"], "minimum": 0 },
        "latched": { "type": ["boolean", "null"] },
        "step": { "enum": ["setup_submitted", null] },
        "pointsEntered": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "coverageVerdict": { "enum": ["covered", "partial", "missing"] },
    "focusCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluatorVersion", "pointsEntered", "pointsSupplied", "pointsEvaluated", "coveredThreshold",
        "partialThreshold", "predicateVersion", "points"
      ],
      "properties": {
        "evaluatorVersion": { "$ref": "#/$defs/token" },
        "predicateVersion": { "$ref": "#/$defs/token" },
        "pointsEntered": { "type": "integer", "minimum": 1 },
        "pointsSupplied": { "type": "integer", "minimum": 1 },
        "pointsEvaluated": { "type": "integer", "minimum": 1 },
        "coveredThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "partialThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "verdict"],
            "properties": {
              "position": { "type": "integer", "minimum": 0 },
              "verdict": { "enum": ["detected", "not_detected"] }
            }
          }
        }
      }
    },
    "candidateTake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSha", "candidateId", "journey", "journeyId", "attemptId", "attemptSeq",
        "comparisonNonce", "persistedSessionId",
        "receiptArtifact", "receiptSha256"
      ],
      "if": { "required": ["journey"], "properties": { "journey": { "const": "focus_points" } } },
      "then": { "required": ["focusCoverage"] },
      "else": { "not": { "required": ["focusCoverage"] } },
      "properties": {
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidateId": { "$ref": "#/$defs/candidate" },
        "journey": { "enum": ["open_mic", "focus_points"] },
        "journeyId": { "$ref": "#/$defs/token" },
        "attemptId": { "$ref": "#/$defs/token" },
        "attemptSeq": { "type": "integer", "minimum": 1 },
        "comparisonNonce": { "$ref": "#/$defs/token" },
        "persistedSessionId": { "$ref": "#/$defs/uuidv4" },
        "receiptArtifact": { "type": "string", "minLength": 1, "maxLength": 240 },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "focusCoverage": { "$ref": "#/$defs/focusCoverage" }
      }
    },
    "outputShape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "whatWorkedItems", "whatToImproveItems", "whatWorkedWhitespaceWords",
        "whatToImproveWhitespaceWords", "readable", "suggestionDigest"
      ],
      "properties": {
        "whatWorkedItems": { "const": 1 },
        "whatToImproveItems": { "const": 1 },
        "whatWorkedWhitespaceWords": { "type": "integer", "minimum": 1, "maximum": 6 },
        "whatToImproveWhitespaceWords": { "type": "integer", "minimum": 1, "maximum": 6 },
        "readable": { "const": true },
        "suggestionDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "userDigest", "utcDate", "limit", "requestNumber"],
      "properties": {
        "scope": { "const": "user_utc_day" },
        "userDigest": { "$ref": "#/$defs/sha256" },
        "utcDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "limit": { "const": 10 },
        "requestNumber": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "geminiObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSha", "candidateId", "journey", "journeyId", "attemptId", "attemptSeq",
        "comparisonNonce", "persistedSessionId", "receiptSha256",
        "source", "model", "providerRequestMade", "quota", "output"
      ],
      "properties": {
        "releaseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "candidateId": { "$ref": "#/$defs/candidate" },
        "journey": { "enum": ["open_mic", "focus_points"] },
        "journeyId": { "$ref": "#/$defs/token" },
        "attemptId": { "$ref": "#/$defs/token" },
        "attemptSeq": { "type": "integer", "minimum": 1 },
        "comparisonNonce": { "$ref": "#/$defs/token" },
        "persistedSessionId": { "$ref": "#/$defs/uuidv4" },
        "receiptSha256": { "$ref": "#/$defs/sha256" },
        "source": { "enum": ["fresh", "cached"] },
        "model": { "const": "gemini-3.6-flash" },
        "providerRequestMade": { "type": "boolean" },
        "quota": { "anyOf": [{ "$ref": "#/$defs/quota" }, { "type": "null" }] },
        "output": { "$ref": "#/$defs/outputShape" }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "primary", "fallback", "sitsOut", "approvalArtifact", "approvalSha256"
      ],
      "properties": {
        "status": { "enum": ["pending_po_test", "selected"] },
        "primary": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "fallback": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "sitsOut": { "anyOf": [{ "$ref": "#/$defs/candidate" }, { "type": "null" }] },
        "approvalArtifact": { "type": ["string", "null"], "maxLength": 240 },
        "approvalSha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    }
  }
}
