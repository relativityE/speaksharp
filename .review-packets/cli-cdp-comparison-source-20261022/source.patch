diff --git a/scripts/model-evaluator/browser-session.ts b/scripts/model-evaluator/browser-session.ts
new file mode 100644
index 000000000..2a5410c85
--- /dev/null
+++ b/scripts/model-evaluator/browser-session.ts
@@ -0,0 +1,41 @@
+import {chromium,type Browser,type BrowserContext,type Page} from 'playwright';
+import {connectLocalCdp,evaluatorContext,localCdpOwner,parseCdpEndpoint,type CdpOwner,type OwnedContextState} from './cdp-browser';
+import {deadline} from './investigation-supervision';
+
+type Dependencies={
+  launch:(headless:boolean)=>Promise<Browser>;
+  connect:(endpoint:string)=>Promise<{browser:Browser;owner:CdpOwner;browserVersion:string}>;
+};
+const dependencies:Dependencies={
+  launch:headless=>chromium.launch({headless}),
+  connect:endpoint=>connectLocalCdp({endpoint,owner:localCdpOwner,
+    connect:websocket=>chromium.connectOverCDP(websocket,{timeout:5000})}),
+};
+/** Own a fresh context; the dedicated CDP browser and its existing tabs are borrowed. */
+export async function openModelBrowser(options:{headless:boolean;cdpEndpoint?:unknown},deps:Dependencies=dependencies) {
+  if(options.cdpEndpoint!==undefined&&typeof options.cdpEndpoint!=='string')throw new Error('Invalid CDP endpoint');
+  const endpoint=parseCdpEndpoint(options.cdpEndpoint as string??'');
+  let contextState:OwnedContextState='NOT_CREATED';
+  let browser:Browser|undefined;
+  let page:Page|undefined;
+  let cdpOwner:CdpOwner|undefined;
+  const contextOwner=evaluatorContext<BrowserContext>({retain:state=>{contextState=state;},exitEvaluator:()=>{}});
+  const close=async()=>{
+    try {await contextOwner.close();}
+    finally {if(!endpoint)await browser?.close();}
+  };
+  try {
+    if(endpoint){
+      const attached=await deadline(deps.connect(endpoint),10000,'STT_CDP_CONNECT');
+      browser=attached.browser;cdpOwner=attached.owner;
+    }else browser=await deps.launch(options.headless);
+    const context=await contextOwner.acquire(()=>browser!.newContext(),10000);
+    page=await deadline(context.newPage(),10000,'STT_OWNED_PAGE');
+    return {page,close,evidence:()=>({browserVersion:browser!.version(),
+      ownership:endpoint?'borrowed-dedicated-cdp':'owned-launch',cdpOwner:cdpOwner??null,
+      ownedContextState:contextState,borrowedBrowserCloseAttempted:false})};
+  }catch(error){
+    try {await close();}catch(cleanup){throw new Error(`${String(error)}; cleanup:${String(cleanup)}`);}
+    throw error;
+  }
+}
diff --git a/scripts/model-evaluator/resource-headroom.ts b/scripts/model-evaluator/resource-headroom.ts
new file mode 100644
index 000000000..999919e4f
--- /dev/null
+++ b/scripts/model-evaluator/resource-headroom.ts
@@ -0,0 +1,41 @@
+import {execFileSync} from 'node:child_process';
+import {totalmem} from 'node:os';
+
+/** Same available-memory method and floors as the existing local model diagnostic. */
+export function availableMemoryBytes():number {
+  if(process.platform==='darwin'){
+    const output=execFileSync('/usr/bin/memory_pressure',['-Q'],{encoding:'utf8',timeout:2000});
+    const match=/System-wide memory free percentage:\s*(\d+)%/.exec(output);
+    if(!match)throw new Error('available memory measure unavailable');
+    return totalmem()*Number(match[1])/100;
+  }
+  if(process.platform==='linux'){
+    const output=execFileSync('cat',['/proc/meminfo'],{encoding:'utf8',timeout:2000});
+    const match=/^MemAvailable:\s*(\d+) kB/m.exec(output);
+    if(!match)throw new Error('MemAvailable unavailable');
+    return Number(match[1])*1024;
+  }
+  throw new Error('memory policy unimplemented for this platform');
+}
+export function memoryGuard(read:()=>number=availableMemoryBytes){
+  const evidence={minStartBytes:2*1024**3,minRunningBytes:1024**3,maxConsecutiveLowSamples:5,
+    startAvailableBytes:null as number|null,minimumObservedAvailableBytes:null as number|null,
+    lowSamples:0,error:null as string|null,method:'Host available headroom; NOT model peak memory'};
+  const sample=()=>{
+    if(evidence.error)return;
+    try {
+      const bytes=read();if(!Number.isFinite(bytes)||bytes<0)throw new Error('memory sample invalid');
+      evidence.minimumObservedAvailableBytes=Math.min(evidence.minimumObservedAvailableBytes??Infinity,bytes);
+      evidence.lowSamples=bytes<evidence.minRunningBytes?evidence.lowSamples+1:0;
+      if(evidence.lowSamples>=evidence.maxConsecutiveLowSamples)evidence.error='HOLD_RESOURCE_HEADROOM_DURING_INFERENCE';
+      return bytes;
+    }catch(error){evidence.error=`HOLD_MEMORY_MEASUREMENT:${String(error)}`;}
+  };
+  return {evidence,sample,
+    assertSafe(){if(evidence.error)throw new Error(evidence.error);},
+    start(){
+      const bytes=sample();evidence.startAvailableBytes=bytes??null;
+      if(bytes!==undefined&&bytes<evidence.minStartBytes)evidence.error='HOLD_RESOURCE_HEADROOM_BELOW_2GIB';
+      if(evidence.error)throw new Error(evidence.error);
+    }};
+}
