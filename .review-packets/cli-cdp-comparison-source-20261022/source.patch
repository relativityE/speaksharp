diff --git a/tests/unit/modelEvaluatorBrowserSession.test.ts b/tests/unit/modelEvaluatorBrowserSession.test.ts
new file mode 100644
index 000000000..b7ebf0d1a
--- /dev/null
+++ b/tests/unit/modelEvaluatorBrowserSession.test.ts
@@ -0,0 +1,47 @@
+import {describe,expect,it,vi} from 'vitest';
+import type {Browser,BrowserContext,Page} from 'playwright';
+import {openModelBrowser} from '../../scripts/model-evaluator/browser-session';
+const fixture=()=>{
+  const page={} as Page;
+  const context={newPage:vi.fn(async()=>page),close:vi.fn(async()=>{})};
+  const browser={newContext:vi.fn(async()=>context as unknown as BrowserContext),close:vi.fn(async()=>{}),version:()=> '156.0.8078.47'};
+  const deps={launch:vi.fn(async()=>browser as unknown as Browser),connect:vi.fn(async()=>({browser:browser as unknown as Browser,
+    owner:{pid:42,profile:'/dedicated',listener:'127.0.0.1:9222'},browserVersion:browser.version()}))};
+  return {page,context,browser,deps};
+};
+describe('STT evaluator owned context with dedicated borrowed Chrome',()=>{
+  it('attaches through the verified helper and never closes the borrowed browser',async()=>{
+    const f=fixture();const session=await openModelBrowser({headless:false,cdpEndpoint:'http://127.0.0.1:9222'},f.deps);
+    expect(f.deps.connect).toHaveBeenCalledWith('http://127.0.0.1:9222');expect(f.deps.launch).not.toHaveBeenCalled();
+    expect(session.page).toBe(f.page);await session.close();await session.close();
+    expect(f.context.close).toHaveBeenCalledOnce();expect(f.browser.close).not.toHaveBeenCalled();
+    expect(session.evidence()).toMatchObject({ownership:'borrowed-dedicated-cdp',ownedContextState:'CLOSED',borrowedBrowserCloseAttempted:false});
+  });
+  it('retains owned-launch behavior and closes only that owned browser',async()=>{
+    const f=fixture();const session=await openModelBrowser({headless:true},f.deps);await session.close();
+    expect(f.deps.launch).toHaveBeenCalledWith(true);expect(f.deps.connect).not.toHaveBeenCalled();
+    expect(f.context.close).toHaveBeenCalledOnce();expect(f.browser.close).toHaveBeenCalledOnce();
+  });
+  it('rejects unselected endpoints before any browser operation',async()=>{
+    for(const cdpEndpoint of ['http://localhost:9222','http://127.0.0.1:9223','https://example.com',42]){
+      const f=fixture();await expect(openModelBrowser({headless:true,cdpEndpoint},f.deps)).rejects.toThrow();
+      expect(f.deps.launch).not.toHaveBeenCalled();expect(f.deps.connect).not.toHaveBeenCalled();
+    }
+  });
+  it('propagates owner refusal without launching a replacement',async()=>{
+    const f=fixture();f.deps.connect.mockRejectedValue(new Error('owner mismatch'));
+    await expect(openModelBrowser({headless:false,cdpEndpoint:'http://127.0.0.1:9222'},f.deps)).rejects.toThrow('owner mismatch');
+    expect(f.browser.newContext).not.toHaveBeenCalled();expect(f.deps.launch).not.toHaveBeenCalled();
+  });
+  it('closes a partially acquired owned context after page creation fails',async()=>{
+    const f=fixture();f.context.newPage.mockRejectedValue(new Error('page failed'));
+    await expect(openModelBrowser({headless:false,cdpEndpoint:'http://127.0.0.1:9222'},f.deps)).rejects.toThrow('page failed');
+    expect(f.context.close).toHaveBeenCalledOnce();expect(f.browser.close).not.toHaveBeenCalled();
+  });
+  it('retains cleanup failure as UNKNOWN without closing borrowed Chrome',async()=>{
+    const f=fixture();f.context.close.mockRejectedValue(new Error('context failed'));
+    const session=await openModelBrowser({headless:false,cdpEndpoint:'http://127.0.0.1:9222'},f.deps);
+    await expect(session.close()).rejects.toThrow('context failed');
+    expect(session.evidence().ownedContextState).toBe('UNKNOWN');expect(f.browser.close).not.toHaveBeenCalled();
+  });
+});
