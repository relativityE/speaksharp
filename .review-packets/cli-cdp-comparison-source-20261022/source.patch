@@ -0,0 +1,21 @@
+import {describe,it,expect} from 'vitest';
+import {memoryGuard} from '../../scripts/model-evaluator/resource-headroom';
+describe('bounded local evaluator headroom',()=>{
+  it('refuses under2GiB before model initialization and accepts the exact floor',()=>{
+    expect(()=>memoryGuard(()=>2*1024**3-1).start()).toThrow('BELOW_2GIB');
+    expect(()=>memoryGuard(()=>2*1024**3).start()).not.toThrow();
+  });
+  it('requires five consecutive low running samples and resets on recovery',()=>{
+    let bytes=2*1024**3;const guard=memoryGuard(()=>bytes);guard.start();bytes=1024**3-1;
+    for(let i=0;i<4;i++)guard.sample();expect(()=>guard.assertSafe()).not.toThrow();
+    bytes=1024**3;guard.sample();expect(guard.evidence.lowSamples).toBe(0);
+    bytes=1024**3-1;for(let i=0;i<5;i++)guard.sample();
+    expect(()=>guard.assertSafe()).toThrow('DURING_INFERENCE');
+    bytes=3*1024**3;guard.sample();expect(()=>guard.assertSafe()).toThrow();
+  });
+  it('fails closed on absent, invalid or failed measurement',()=>{
+    for(const read of [()=>NaN,()=>-1,()=>{throw new Error('measurement unavailable');}]){
+      expect(()=>memoryGuard(read).start()).toThrow('HOLD_MEMORY_MEASUREMENT');
+    }
+  });
+});
