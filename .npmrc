# node-linker=hoisted already produces a flat, symlink-free node_modules (npm/yarn-style).
# shamefully-hoist=true is an ISOLATED-linker modifier and is incompatible with node-linker=hoisted
# (pnpm#6620); the pair triggers a flaky cold-install failure creating scoped dirs like @radix-ui
# (pnpm#6534). Keep only node-linker=hoisted.
node-linker=hoisted
auto-install-peers=true