# #1195: node-linker=hoisted has an open pnpm bug (#6534) that fails cold installs creating scoped
# dirs like @radix-ui (ERR_PNPM_ENOENT). Use the default (isolated/symlinked) linker with
# shamefully-hoist to still hoist deps to the root node_modules — the supported flat-ish layout.
auto-install-peers=true
shamefully-hoist=true