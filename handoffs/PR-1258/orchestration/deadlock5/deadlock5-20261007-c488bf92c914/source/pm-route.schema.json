{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1
    },
    "next": {
      "type": "string",
      "enum": [
        "dev",
        "po",
        "none"
      ]
    },
    "board_updates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "work_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_key": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "state": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "active",
                  "ready",
                  "blocked",
                  "waiting",
                  "done",
                  "closed",
                  "merged",
                  null
                ]
              },
              "owner": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "po",
                  "cli_pm",
                  "cli_dev",
                  "app_dev",
                  "browser_pm",
                  "external",
                  "unassigned",
                  null
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocker_since": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "next_action": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "po_required": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "release_blocker": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pr_number": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "worktree": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "item_key",
              "priority",
              "title",
              "state",
              "owner",
              "branch",
              "blocker",
              "blocker_since",
              "next_action",
              "po_required",
              "release_blocker",
              "notes",
              "pr_number",
              "worktree"
            ]
          },
          "minItems": 1
        },
        "players": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "player_id": {
                "type": "string",
                "enum": [
                  "po",
                  "cli_pm",
                  "cli_dev",
                  "app_dev",
                  "browser_pm"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "task": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "work_item_key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocker": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "holding": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "checkpoint_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "player_id",
              "status",
              "task",
              "work_item_key",
              "blocker",
              "holding",
              "source",
              "checkpoint_at"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "work_items",
        "players"
      ]
    },
    "pm_actions": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "description": "refresh_reviews may only perform an authorized Ready→Draft→Ready lifecycle on an exact open PR candidate; review completion is a separate observation.",
            "enum": [
              "mark_ready",
              "rerun_failed_jobs",
              "dispatch_full_ci",
              "open_draft_pr",
              "refresh_reviews"
            ]
          },
          "pr_number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "base": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "source_comment_id": {
            "type": "integer"
          },
          "run_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "run_attempt": {
            "type": [
              "integer",
              "null"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "pr_number",
          "head",
          "base",
          "source_comment_id",
          "run_id",
          "run_attempt",
          "branch",
          "title",
          "body"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "refresh_reviews"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "pr_number": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        ]
      }
    },
    "publish": {
      "type": "boolean",
      "description": "False for routine board-only reconciliation with no new externally actionable instruction/result. Host forces publication for actions or Dev/PO handoff."
    }
  },
  "required": [
    "message",
    "next",
    "board_updates",
    "pm_actions",
    "publish"
  ]
}
