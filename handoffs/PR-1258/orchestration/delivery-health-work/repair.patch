+                            "AND status IN ('failed','failed_uncertain') ORDER BY id DESC LIMIT 1").fetchone()
+        delivery = None
+        # Match activity AND queue id, not the nearest timestamp or last wake.
+        for qid in reversed((event or {}).get('queue_ids', [])):
+            row = c.execute("SELECT * FROM queue WHERE id=? AND activity_id=? AND recipient='pm' "
+                            "AND source_actor='GITHUB'", (qid, event.get('activity_id'))).fetchone()
+            if row:
+                delivery = dict(row)
