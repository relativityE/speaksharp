+def github_delivery_health(executor_configured=None):
+    """Read-only event→native-PM trace. A returned response is not a task ACK.
+
+    No recovery is attempted here: an errored worker may own an uncertain
+    side effect and must not be reset or replaced by a dashboard refresh.
+    """
