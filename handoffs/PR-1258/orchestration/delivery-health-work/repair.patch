+import json
+import importlib.util
+import contextlib
+import io
+import sys
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+import server
+import test_comms
+
+
+class DeliveryHealthTests(unittest.TestCase):
+    setUp = test_comms.CommsTests.setUp
+    tearDown = test_comms.CommsTests.tearDown
+
+    def event(self, comment=71, head='a' * 40):
+        server.emit_github_event(['review packet ' + str(comment)], {
+            'pr': 1612, 'head': head, 'latest_control_comment_id': comment,
+        }, {'pm_github_control': True})
+        return server.github_delivery_health()
+
+    def test_fresh_poll_and_queue_are_not_recipient_wake(self):
+        server.set_setting('github_watch_last_poll', server.now())
+        health = self.event()
+        self.assertEqual(health['state'], 'queued')
+        self.assertEqual(health['latest_event']['comment_id'], 71)
+        self.assertEqual(health['latest_delivery']['recipient'], 'pm')
+        self.assertIsNone(health['latest_delivery']['receipt_at'])
+        self.assertFalse(health['end_to_end_proven'])
+
+    def test_error_names_failed_delivery_without_replaying_or_clearing_it(self):
+        first = self.event()
+        old = first['latest_delivery']['id']
+        server.update_queue(old, status='failed', error='executor exited before a response', finished_at=server.now())
+        server.set_agent('pm', status='error')
+        health = self.event(72)
+        self.assertEqual(health['state'], 'executor_error')
+        self.assertEqual(health['last_failure']['id'], old)
+        self.assertEqual(health['last_failure']['error'], 'executor exited before a response')
+        self.assertIn('state=error', health['latest_delivery']['blocker'])
+        self.assertNotEqual(old, health['latest_delivery']['id'])
+        self.assertIsNone(server.next_queue('pm'))
