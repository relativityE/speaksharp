+                                  or not isinstance(event.get('queue_ids'), list)
+                                  or type(event.get('activity_id')) is not int
+                                  or any(type(qid) is not int or qid <= 0 for qid in event['queue_ids'])):
+            raise ValueError('invalid dispatch trace')
+    except (ValueError, TypeError):
+        event = None
+    with DB_LOCK, con() as c:
+        pending = c.execute("SELECT count(*) FROM queue WHERE recipient='pm' AND status='queued'").fetchone()[0]
