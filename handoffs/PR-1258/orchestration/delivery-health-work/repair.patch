@@ -0,0 +1,173 @@
+import json
+import importlib.util
+import contextlib
+import io
+import sys
+from pathlib import Path
+import unittest
+from unittest.mock import patch
+
+import server
+import test_comms
+
+
+class DeliveryHealthTests(unittest.TestCase):
+    setUp = test_comms.CommsTests.setUp
+    tearDown = test_comms.CommsTests.tearDown
+
+    def event(self, comment=71, head='a' * 40):
+        server.emit_github_event(['review packet ' + str(comment)], {
+            'pr': 1612, 'head': head, 'latest_control_comment_id': comment,
+        }, {'pm_github_control': True})
+        return server.github_delivery_health()
+
+    def test_fresh_poll_and_queue_are_not_recipient_wake(self):
+        server.set_setting('github_watch_last_poll', server.now())
+        health = self.event()
+        self.assertEqual(health['state'], 'queued')
+        self.assertEqual(health['latest_event']['comment_id'], 71)
+        self.assertEqual(health['latest_delivery']['recipient'], 'pm')
+        self.assertIsNone(health['latest_delivery']['receipt_at'])
+        self.assertFalse(health['end_to_end_proven'])
+
+    def test_error_names_failed_delivery_without_replaying_or_clearing_it(self):
+        first = self.event()
+        old = first['latest_delivery']['id']
+        server.update_queue(old, status='failed', error='executor exited before a response', finished_at=server.now())
+        server.set_agent('pm', status='error')
+        health = self.event(72)
+        self.assertEqual(health['state'], 'executor_error')
+        self.assertEqual(health['last_failure']['id'], old)
+        self.assertEqual(health['last_failure']['error'], 'executor exited before a response')
+        self.assertIn('state=error', health['latest_delivery']['blocker'])
+        self.assertNotEqual(old, health['latest_delivery']['id'])
+        self.assertIsNone(server.next_queue('pm'))
+        self.assertEqual(server.get_agent('pm')['status'], 'error')
+
+    def test_coalesced_event_links_current_head_to_the_same_pending_delivery(self):
+        first = self.event()
+        second = self.event(72, 'b' * 40)
+        self.assertEqual(first['latest_delivery']['id'], second['latest_delivery']['id'])
+        self.assertEqual(second['latest_event']['comment_id'], 72)
+        self.assertEqual(second['latest_event']['head'], 'b' * 40)
+        self.assertEqual(second['latest_event']['activity_id'], second['latest_delivery']['activity_id'])
+
+    def test_disabled_routing_is_not_a_successful_wake(self):
+        server.emit_github_event(['observed only'], {'pr': 1612}, {})
+        health = server.github_delivery_health()
+        self.assertEqual(health['state'], 'event_not_routed')
+        self.assertIsNone(health['latest_delivery'])
+        self.assertFalse(health['end_to_end_proven'])
+
+    def test_started_and_returned_response_are_separate_from_matching_ack(self):
+        health = self.event()
+        qid = health['latest_delivery']['id']
+        server.update_queue(qid, status='delivering', session_id='native-session', started_at=server.now())
+        self.assertEqual(server.github_delivery_health()['state'], 'invocation_started')
+        server.update_queue(qid, status='responded', finished_at=server.now())
+        returned = server.github_delivery_health()
+        self.assertEqual(returned['state'], 'response_returned')
+        self.assertFalse(returned['end_to_end_proven'])
+        self.assertIsNone(returned['latest_delivery']['receipt_at'])
+
+    def test_restart_keeps_delivery_trace_but_does_not_claim_a_current_boot_wake(self):
+        first = self.event()
+        with patch.object(server, 'SESSION_BOOT_ID', 'new-boot'):
+            health = server.github_delivery_health()
+        self.assertEqual(first['latest_delivery']['id'], health['latest_delivery']['id'])
+        self.assertFalse(health['event_on_current_boot'])
+        self.assertFalse(health['end_to_end_proven'])
+
+    def test_health_is_read_only_and_does_not_publish_or_start_workers(self):
+        self.event()
+        before = server.list_queue()
+        with patch.object(server, 'enqueue') as enqueue, patch.object(server, 'run_pm') as invoke:
+            server.github_delivery_health()
+            server.github_delivery_health()
+        enqueue.assert_not_called()
+        invoke.assert_not_called()
+        self.assertEqual(before, server.list_queue())
+
+    def test_unrelated_or_damaged_dispatch_identity_is_not_claimed_as_delivery(self):
+        health = self.event()
+        intent = health['latest_event']
+        intent['activity_id'] = -1
+        server.set_setting('github_watch_latest_dispatch', json.dumps(intent))
+        self.assertEqual(server.github_delivery_health()['state'], 'event_not_routed')
+        server.set_setting('github_watch_latest_dispatch', 'not-json')
+        self.assertEqual(server.github_delivery_health()['state'], 'trace_unavailable')
+        server.set_setting('github_watch_latest_dispatch', json.dumps({'activity_id': 1, 'queue_ids': [{}]}))
+        self.assertEqual(server.github_delivery_health()['state'], 'trace_unavailable')
+
+    def test_cleanup_pause_and_missing_runtime_take_precedence_over_queued(self):
+        self.event()
+        self.assertEqual(server.github_delivery_health(False)['state'], 'executor_unavailable')
+        server.set_agent('pm', paused=1)
+        self.assertEqual(server.github_delivery_health()['state'], 'executor_paused')
+        server.set_setting('pm_cleanup_unverified', 'owned process must be reconciled')
+        self.assertEqual(server.github_delivery_health()['state'], 'cleanup_unverified')
+
+    def test_native_executor_error_is_not_labelled_as_negotiation_or_removed_pairing_steps(self):
+        t = {'pm_configured': True, 'agent_routes': {}}
+        h = server.coordination_health.summarize(t, {'pm': {'status': 'error'}}, {})
+        native = next(a for a in h['support'] if a['actor'] == 'cli_pm')
+        self.assertEqual(native['state'], 'blocked')
+        self.assertNotIn('Connect + test', ' '.join(h['setup_steps']))
+        self.assertIn('Devs do not install', ' '.join(h['setup_steps']))
+
+    def test_existing_native_error_is_visible_in_transport_and_coordinator_identity(self):
+        self.event()
+        server.set_agent('pm', status='error')
+        with patch.object(server, 'pm_transport_mode', return_value='codex'), patch.object(server, 'resolved_bin', return_value='/fixture/codex'), patch.object(server, 'CODEX_AUTH_OK', True):
+            status = server.transport_status()
+        native = status['agent_routes']['cli_pm']
+        self.assertFalse(native['executor_ready'])
+        self.assertIn('error', native['blocker'])
+        self.assertEqual(status['delivery_pipeline']['state'], 'executor_error')
+        for key in ('host', 'pid', 'boot_id', 'port', 'install_root', 'build'):
+            self.assertTrue(status['coordinator'][key])
+
+
+class SetupHealthTests(unittest.TestCase):
+    def setUp(self):
+        spec = importlib.util.spec_from_file_location('orch_setup_health_test', Path(__file__).parent / 'orch-setup.py')
+        self.setup = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(self.setup)
+
+    def check(self, live):
+        output = io.StringIO()
+        with patch.object(sys, 'argv', ['orch-setup.py', '--check']), \
+             patch.object(self.setup, 'running_board', return_value=live), \
+             patch.object(self.setup, 'prerequisites', return_value=[]), \
+             patch.object(self.setup.package_integrity, 'verify', return_value=[]), \
+             patch.object(self.setup.subprocess, 'call') as start, contextlib.redirect_stdout(output):
+            code = self.setup.main()
+        start.assert_not_called()
+        return code, json.loads(output.getvalue())
+
+    def test_absent_board_is_not_a_healthy_coordination_check(self):
+        code, report = self.check(None)
+        self.assertEqual(code, 2)
+        self.assertEqual(report['state'], 'board_not_running')
+        self.assertFalse(report['ready'])
+
+    def test_old_build_of_same_version_is_not_mistaken_for_an_upgrade(self):
+        code, report = self.check({'version': '4.7.14', 'build': 'coordination.8-work',
+                                   'transport': {'coordination': {'core_ready': True}}})
+        self.assertEqual(code, 2)
+        self.assertIn('no upgrade occurred', report['next'])
+
+    def test_current_build_exposes_actual_worker_failure_and_host_identity(self):
+        live = {'version': '4.7.14', 'build': self.setup.REQUESTED_BUILD, 'transport': {
+            'coordination': {'core_ready': False}, 'coordinator': {'host': 'coordinator-A', 'boot_id': 'boot-A'},
+            'delivery_pipeline': {'state': 'executor_error', 'last_failure': {'id': 11, 'error': 'worker failed'}}}}
+        code, report = self.check(live)
+        self.assertEqual(code, 2)
+        self.assertEqual(report['coordinator'], live['transport']['coordinator'])
+        self.assertEqual(report['delivery_pipeline']['last_failure']['id'], 11)
+        live['transport']['coordination']['core_ready'] = True
+        self.assertEqual(self.check(live)[0], 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
