+def request_session_registration(reason, actors=None):
+    """Dashboard/startup/stale recovery runs in the foreground board, not a Mac daemon."""
+    challenges = []
+    with DB_LOCK, con() as c:
+        for actor in actors or session_registration.ACTORS:
+            challenge = session_registration.request(c, SESSION_BOOT_ID, actor, reason, time.time())
+            if challenge:
+                challenges.append(challenge)
+    for challenge in challenges:
+        message = ('SESSION_HELLO ' + json.dumps(challenge, sort_keys=True) +
+                   ' — Read your CURRENT runtime session UUID, not the persisted recipient route. '
+                   'Return result evidence as JSON {"nonce":"' + challenge['nonce'] +
+                   '","runtime_session_id":"<actual UUID>","runtime_provider":"codex or claude"}. '
+                   'Use this notice authenticated receipt/result callback. Identity ACK is not idle-wake proof. '
+                   'CLI PM must reconcile any changed route and restore a supported tracked watcher or owned '
+                   'registered consumer; do not create another writer, replay uncertain actions or claim unsupported wake.')
+        # CLI PM uses the sole executor; the other roles receive authenticated
+        # awareness notices, never repository tasks. The challenge names its actor.
+        aid = add_activity('SYSTEM', message, 'pm', 'posted')
+        enqueue(aid, 'pm', message, source_actor='SYSTEM', kind='session_negotiation',
+                delivery_key='session-hello:' + challenge['nonce'])
+        if challenge['actor'] != 'cli_pm':
+            persist_event_notifications(message, event_key=challenge['nonce'], notice_kind='session-handshake',
+                                        target_actor=challenge['actor'], dispatch=False)
+    return challenges
+
+
+def sweep_session_registration(at=None):
+    global SESSION_LAST_TICK
+    at = time.time() if at is None else float(at)
+    if SESSION_LAST_TICK is not None and (at - SESSION_LAST_TICK > 120 or at < SESSION_LAST_TICK):
+        request_session_registration('host-resume:' + str(int(at)))
+    SESSION_LAST_TICK = at
+    for actor in ('app_dev', 'cli_dev'):
+        try:
+            route = configured_actor_route(actor)
+        except agent_transport.RouteError:
+            continue
+        if route.provider != 'local_inbox':
+            continue
+        health = actor_channels.listener_status(actor, route.session_id)
+        seen = health['listener_last_seen']
+        if seen is None or at - seen >= 60 or health['listener_state'] not in ('listening','working'):
+            import worker_runtime
+            worker = worker_runtime.status(actor, route.session_id)
+            if worker and worker.get('recent') and worker.get('status') in ('listening','working'):
+                continue
+            request_session_registration('listener-loss:' + route.session_id + ':' + str(seen), (actor,))
 
 
