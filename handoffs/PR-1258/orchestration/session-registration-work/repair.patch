@@ -0,0 +1,37 @@
+import unittest
+from unittest.mock import Mock
+from agent_transport import RouteError
+from session_rebinding import identity_decision,rebind_clear_route
+
+class RebindingTests(unittest.TestCase):
+    def setUp(self):
+        self.route={'provider':'codex_app_server','session_id':'old'}
+        self.report={'state':'identity_reported','session':'current','provider':'codex'}
+    def test_clear_reported_codex_route_is_rebound_once(self):
+        pair=Mock()
+        result=rebind_clear_route('cli_dev',self.route,self.report,outstanding=False,busy=False,pair=pair)
+        self.assertEqual(result['state'],'route_rebound')
+        pair.assert_called_once_with('cli_dev','codex_app_server','current')
+    def test_pending_task_or_live_writer_prevents_rebind(self):
+        for outstanding,busy in [(True,False),(False,True),(True,True)]:
+            pair=Mock()
+            result=rebind_clear_route('cli_dev',self.route,self.report,outstanding=outstanding,busy=busy,pair=pair)
+            self.assertEqual(result['state'],'route_rebind_pending')
+            pair.assert_not_called()
+    def test_final_pairing_race_preserves_hold(self):
+        result=rebind_clear_route('cli_dev',self.route,self.report,outstanding=False,busy=False,pair=Mock(side_effect=RouteError('pending changed')))
+        self.assertEqual(result['error'],'pending changed')
+    def test_inbox_uuid_is_not_a_runtime_thread_uuid(self):
+        route={'provider':'local_inbox','session_id':'pairing'}
+        worker={'session':'pairing','thread_id':'current'}
+        self.assertEqual(identity_decision(route,self.report,worker)['state'],'identity_matches_worker')
+        self.assertFalse(identity_decision(route,self.report,worker)['rebind'])
+        self.assertEqual(identity_decision(route,self.report)['state'],'identity_reported_inbox')
+    def test_worker_thread_change_requires_reconciliation(self):
+        self.assertEqual(identity_decision({'provider':'local_inbox','session_id':'pairing'},self.report,
+            {'session':'pairing','thread_id':'other'})['state'],'runtime_changed')
+    def test_ack_is_required_and_provider_must_match(self):
+        self.assertEqual(identity_decision(self.route,{})['state'],'awaiting_identity')
+        self.assertEqual(identity_decision(self.route,dict(self.report,provider='claude'))['state'],'provider_mismatch')
+
+if __name__=='__main__':unittest.main()
