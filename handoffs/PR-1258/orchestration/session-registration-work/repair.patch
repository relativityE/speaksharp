+import json
+import sqlite3
+import unittest
+from unittest.mock import patch
+import session_registration as registration
+import server
+from test_comms import CommsTests
+
+SESSION = '01a0f83f-a51b-76e3-ae4f-e45aec3c6980'
+
+class LedgerTests(unittest.TestCase):
+    def setUp(self):
+        self.db = sqlite3.connect(':memory:')
+        self.db.row_factory = sqlite3.Row
+    def tearDown(self):
+        self.db.close()
+    def test_reload_coalesces_and_boot_replaces_nonce(self):
+        first = registration.request(self.db,'boot','cli_dev','dashboard-open',100)
+        self.assertIsNone(registration.request(self.db,'boot','cli_dev','dashboard-open',101))
+        second = registration.request(self.db,'next','cli_dev','dashboard-open',102)
+        self.assertNotEqual(first['nonce'],second['nonce'])
+        with self.assertRaises(ValueError):
+            registration.report(self.db,'next','cli_dev',first['nonce'],SESSION,'codex',103)
+    def test_actor_nonce_uuid_and_duplicate_validation(self):
+        first = registration.request(self.db,'boot','cli_dev','dashboard-open',100)
+        for actor,nonce,sid in [('app_dev',first['nonce'],SESSION),('cli_dev','wrong',SESSION),('cli_dev',first['nonce'],'invalid')]:
+            with self.assertRaises(ValueError):
+                registration.report(self.db,'boot',actor,nonce,sid,'codex',101)
+        self.assertTrue(registration.report(self.db,'boot','cli_dev',first['nonce'],SESSION,'codex',102))
+        self.assertFalse(registration.report(self.db,'boot','cli_dev',first['nonce'],SESSION,'codex',103))
+        self.assertEqual(registration.snapshot(self.db,'boot')['cli_dev']['state'],'identity_reported')
+    def test_listener_loss_new_challenge_never_implies_wake(self):
+        first = registration.request(self.db,'boot','cli_dev','dashboard-open',100)
+        registration.report(self.db,'boot','cli_dev',first['nonce'],SESSION,'codex',101)
+        second = registration.request(self.db,'boot','cli_dev','listener-loss',102)
+        self.assertNotEqual(first['nonce'],second['nonce'])
+        self.assertIsNone(registration.request(self.db,'boot','cli_dev','listener-loss',103))
+        self.assertEqual(registration.snapshot(self.db,'boot')['cli_dev']['state'],'awaiting_ack')
+
+class IntegrationTests(CommsTests):
+    def test_bootstrap_does_not_wait_for_github_or_task_ledger(self):
+        with patch.object(server,'compact_pr_context',side_effect=AssertionError('startup must not fetch GitHub')),patch.object(server,'list_work_items',side_effect=AssertionError('startup must not load task ledger')):
+            content=server.compose_for_pm({'kind':'session_negotiation','content':'SESSION_HELLO bounded challenge'})
+        self.assertTrue(content.startswith('ORCH_IDENTITY_ONLY\n'))
+        with patch.object(server,'load_pm_instructions',side_effect=AssertionError('no task protocol in identity turn')):
+            prompt=server._codex_prompt(content)
+        self.assertIn('No tools',prompt)
+        self.assertIn('board_updates=null',prompt)
+
+    def test_native_coordinator_needs_no_external_actor_pairing(self):
+        server.PM_MODE='codex'
+        server.CODEX_AUTH_OK=True
+        with patch.object(server,'resolved_bin',return_value='/test/codex'),patch.object(server,'configured_actor_route',side_effect=server.agent_transport.RouteError('not paired')):
+            native=server.transport_status()['agent_routes']['cli_pm']
+        self.assertTrue(native['configured'])
+        self.assertEqual(native['transport'],'native_pm_executor')
+        self.assertFalse(native['live_delivery_proven'])
+
+    def test_authenticated_callback_records_identity_but_not_wake(self):
+        challenge=server.request_session_registration('dashboard-open',('cli_dev',))[0]
+        with server.con() as c:
+            notice=c.execute("SELECT * FROM agent_notifications WHERE task_id='session-handshake'").fetchone()
+            action=notice['action_id']
+            c.execute("UPDATE agent_notifications SET target_session_id=?,status='awaiting_receipt' WHERE action_id=?",(SESSION,action))
+        token=server._notification_callback_token(action,'cli_dev',SESSION)
+        payload={'action_id':action,'actor_id':'cli_dev','session_id':SESSION,'stage':'result',
+                 'evidence':json.dumps({'nonce':challenge['nonce'],'runtime_session_id':SESSION,'runtime_provider':'codex'})}
+        self.assertEqual(server.record_agent_task_callback(payload,token)[0],409)
+        self.assertEqual(server.record_agent_task_callback(dict(payload,stage='receipt',evidence='identity request received'),token)[0],200)
+        self.assertEqual(server.record_agent_task_callback(payload,token)[0],200)
+        self.assertEqual(server.registration_snapshot()['cli_dev']['state'],'identity_reported')
+
+    def test_native_pm_handshake_does_not_require_task_ownership_patch(self):
+        server.PM_MODE='codex'
+        server.request_session_registration('dashboard-open',('cli_pm',))
+        q=next(q for q in server.list_queue() if q['kind']=='session_negotiation')
+        with patch.object(server,'_run_pm_codex',return_value=({'message':'ACK current runtime','next':'none'},SESSION)):
+            server.run_pm(q)
+        self.assertEqual(server.registration_snapshot()['cli_pm']['session'],SESSION)
+        self.assertEqual(server.list_queue()[0]['status'],'responded')
+
+    def test_startup_addresses_each_role_without_fanout_duplicates(self):
+        with patch.object(server,'dispatch_event_notifications') as dispatch:
+            first = server.request_session_registration('dashboard-open')
+            self.assertEqual(len(first),4)
+            self.assertEqual(len(server.request_session_registration('dashboard-open')),0)
+            dispatch.assert_not_called()
+        with server.con() as c:
+            notices=list(c.execute("SELECT actor_id,instruction FROM agent_notifications WHERE task_id='session-handshake'"))
+        self.assertEqual(len(notices),3)
+        for row in notices:
+            challenge=next(x for x in first if x['actor']==row['actor_id'])
+            self.assertIn(challenge['nonce'],row['instruction'])
+        self.assertEqual(len([q for q in server.list_queue() if q['kind']=='session_negotiation']),4)
+    def test_watcher_loss_requests_registration_once(self):
+        route=type('Route',(),{'provider':'local_inbox','session_id':SESSION})()
+        with patch.object(server,'configured_actor_route',return_value=route),patch.object(server.actor_channels,'listener_status',return_value={'listener_last_seen':100,'listener_state':'waiting_for_rearm'}),patch('worker_runtime.status',return_value=None):
+            server.SESSION_LAST_TICK=150
+            server.sweep_session_registration(160)
+            server.sweep_session_registration(161)
+        self.assertEqual(len([q for q in server.list_queue() if q['kind']=='session_negotiation']),2)
+    def test_sleep_gap_negotiates_all_roles(self):
+        with patch.object(server,'configured_actor_route',side_effect=server.agent_transport.RouteError('unpaired')):
+            server.SESSION_LAST_TICK=100
+            server.sweep_session_registration(900)
+        self.assertEqual(len(server.registration_snapshot()),4)
+
+if __name__=='__main__':
+    unittest.main()
