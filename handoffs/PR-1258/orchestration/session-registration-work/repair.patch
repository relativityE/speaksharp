diff --git a/session_rebinding.py b/session_rebinding.py
new file mode 100644
index 0000000..36b833c
--- /dev/null
+++ b/session_rebinding.py
@@ -0,0 +1,40 @@
+"""Distinguish a runtime thread UUID from an inbox pairing UUID before recovery."""
+from agent_transport import RouteError
+
+
+def identity_decision(route, reported, worker=None):
+    runtime = reported.get('session')
+    if not runtime or reported.get('state') != 'identity_reported':
+        return {'state': 'awaiting_identity', 'rebind': False}
+    if route.get('provider') == 'local_inbox':
+        # Inbox UUID is a channel identity, deliberately NOT the Codex thread UUID.
+        # Never overwrite it with CODEX_THREAD_ID merely because the strings differ.
+        if worker and worker.get('session') == route.get('session_id'):
+            expected = worker.get('thread_id')
+            if expected == runtime:
+                return {'state': 'identity_matches_worker', 'rebind': False}
+            return {'state': 'runtime_changed', 'rebind': False,
+                    'error': 'Registered worker thread differs; reconcile owned worker before resume'}
+        return {'state': 'identity_reported_inbox', 'rebind': False,
+                'error': 'Inbox identity retained; runtime consumer registration still required'}
+    if route.get('provider') == 'codex_app_server':
+        if reported.get('provider') != 'codex':
+            return {'state': 'provider_mismatch', 'rebind': False}
+        return {'state': 'identity_matches_route' if runtime == route.get('session_id') else 'route_rebind_pending',
+                'rebind': runtime != route.get('session_id')}
+    return {'state': 'unsupported_route', 'rebind': False}
+
+
+def rebind_clear_route(actor, route, reported, *, outstanding, busy, pair):
+    decision = identity_decision(route, reported)
+    if not decision.get('rebind'):
+        return decision
+    if outstanding or busy:
+        return {'state': 'route_rebind_pending', 'rebind': False,
+                'error': 'Old route has pending actions or live writer; no task replay or duplicate turn'}
+    try:
+        # Existing pairing operation rechecks durable pending state and role uniqueness.
+        pair(actor, route['provider'], reported['session'])
+    except RouteError as exc:
+        return {'state': 'route_rebind_pending', 'rebind': False, 'error': str(exc)}
+    return {'state': 'route_rebound', 'rebind': True, 'session_id': reported['session']}
diff --git a/session_registration.py b/session_registration.py
new file mode 100644
index 0000000..a5057bf
--- /dev/null
+++ b/session_registration.py
@@ -0,0 +1,44 @@
+"""Per-launch identity challenges. Identity reports never imply idle wake proof."""
+import uuid
+
+ACTORS = ('cli_pm', 'cli_dev', 'app_dev', 'browser_pm')
+
+def schema(c):
+    c.execute('CREATE TABLE IF NOT EXISTS session_registration(actor TEXT PRIMARY KEY, boot TEXT, nonce TEXT, reason TEXT, requested REAL, reported REAL, session TEXT, provider TEXT, state TEXT)')
+
+def request(c, boot, actor, reason, at):
+    schema(c)
+    if actor not in ACTORS:
+        raise ValueError('unknown actor')
+    old = c.execute('SELECT * FROM session_registration WHERE actor=?', (actor,)).fetchone()
+    if old and old['boot'] == boot:
+        # Reloads and repeated stale polls share one pending challenge. A reported
+        # identity can be challenged again only for a new health incident.
+        if old['state'] == 'awaiting_ack' and at - old['requested'] < 300:
+            return None
+        if old['reason'] == reason:
+            return None
+    nonce = uuid.uuid4().hex
+    c.execute('INSERT OR REPLACE INTO session_registration VALUES(?,?,?,?,?,NULL,NULL,NULL,?)',
+              (actor, boot, nonce, reason, at, 'awaiting_ack'))
+    return {'actor': actor, 'boot': boot, 'nonce': nonce, 'reason': reason}
+
+def report(c, boot, actor, nonce, session, provider, at):
+    schema(c)
+    row = c.execute('SELECT * FROM session_registration WHERE actor=?', (actor,)).fetchone()
+    if not row or row['boot'] != boot or row['nonce'] != nonce:
+        raise ValueError('stale or mismatched identity challenge')
+    session = str(uuid.UUID(session))
+    if provider not in ('codex', 'claude'):
+        raise ValueError('unsupported runtime identity provider')
+    if row['reported'] is not None:
+        if row['session'] != session or row['provider'] != provider:
+            raise ValueError('conflicting identity ACK')
+        return False
+    c.execute("UPDATE session_registration SET reported=?,session=?,provider=?,state='identity_reported' WHERE actor=?",
+              (at, session, provider, actor))
+    return True
+
+def snapshot(c, boot):
+    schema(c)
+    return {r['actor']: dict(r) for r in c.execute('SELECT * FROM session_registration WHERE boot=?', (boot,))}
