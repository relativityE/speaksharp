+                {'provider': route.provider, 'session_id': route.session_id}, report, worker)
+        except agent_transport.RouteError as exc:
+            report['binding'] = {'state':'route_unavailable','error':str(exc),'rebind':False}
+    return rows
+
+
+def reconcile_registered_identity(actor):
+    with DB_LOCK, con() as c:
+        report = session_registration.snapshot(c, SESSION_BOOT_ID).get(actor, {})
+        try:
+            route = configured_actor_route(actor)
+        except agent_transport.RouteError:
+            return
+        # Frozen repository tasks remain immutable. Never redirect their ACK target.
+        outstanding = bool(c.execute("SELECT 1 FROM queue WHERE target_actor_id=? AND status NOT IN ('responded','failed','cancelled') LIMIT 1",(actor,)).fetchone()
+            or c.execute("SELECT 1 FROM agent_notifications WHERE actor_id=? AND target_session_id<>'' AND status NOT IN ('responded','cancelled','superseded') LIMIT 1",(actor,)).fetchone())
+        import worker_runtime
+        worker = worker_runtime.status(actor, route.session_id)
+        busy = bool(worker and (worker.get('status') not in ('stopped','listening','board_unavailable')
+                               or worker_supervisor.alive(worker.get('runtime_pid'))))
+        decision = session_rebinding.rebind_clear_route(actor,
+            {'provider':route.provider,'session_id':route.session_id},report,
+            outstanding=outstanding,busy=busy,
+            pair=lambda role,provider,session: pair_actor_route({'actor_id':role,'provider':provider,'session_id':session}))
+    if decision.get('rebind'):
+        request_session_registration('route-changed:'+decision['session_id'],(actor,))
+    return decision
