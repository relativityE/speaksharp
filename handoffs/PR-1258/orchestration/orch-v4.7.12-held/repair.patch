+from unittest.mock import patch
+from test_actor_channels import ActorChannelTests
+import server
+import coordination_recovery
+
+
+class EventQueueRecoveryTests(ActorChannelTests):
+    def test_unread_awareness_coalesces_but_a_presented_notice_is_preserved(self):
+        self.pair()
+        server.persist_event_notifications('old CI snapshot', event_key='old')
+        with server.con() as db:
+            first = dict(db.execute("SELECT * FROM agent_notifications WHERE actor_id='app_dev' AND task_id='event-observation'").fetchone())
+        server.persist_event_notifications('new review snapshot', event_key='new')
+        with server.con() as db:
+            self.assertEqual(db.execute('SELECT status FROM agent_notifications WHERE action_id=?', (first['action_id'],)).fetchone()[0], 'superseded')
+        visible = server.actor_inbox('app_dev', first['target_session_id'], self.token())
+        self.assertEqual(len(visible), 1)
+        self.assertIn('new review snapshot', visible[0]['body'])
+        server.persist_event_notifications('later merge snapshot', event_key='later')
+        with server.con() as db:
+            self.assertEqual(db.execute('SELECT status FROM agent_notifications WHERE action_id=?', (visible[0]['action_id'],)).fetchone()[0], 'awaiting_receipt')
+
+    def test_repeating_old_event_cannot_supersede_newer_inbox_notice(self):
+        self.pair()
+        server.persist_event_notifications('old', event_key='old')
+        server.persist_event_notifications('new', event_key='new')
+        server.persist_event_notifications('old', event_key='old')
+        with server.con() as db:
+            rows = [dict(row) for row in db.execute("SELECT * FROM agent_notifications WHERE actor_id='app_dev' AND status='awaiting_receipt'")]
+        self.assertEqual(len(rows), 1)
+        self.assertIn('new', rows[0]['instruction'])
+
+    def test_settled_original_notification_is_in_current_turn_context(self):
+        self.pair()
+        original = server.probe_actor_route('app_dev')
+        self.callback(original, 'receipt', 'received')
+        self.callback(original, 'result', 'wake=automatic; observed')
+        for _ in range(25):
+            later = server.probe_actor_route('app_dev')
+            self.callback(later, 'receipt', 'received')
+            self.callback(later, 'result', 'wake=automatic; observed')
+        context = coordination_recovery.context(server.con, server.actor_channels,
+                                               {'delivery_key': 'task-result:' + original['action_id']})
+        self.assertEqual(context['original_notification']['action_id'], original['action_id'])
+        self.assertEqual(context['original_notification']['status'], 'responded')
+        self.assertTrue(context['original_notification']['receipt_at'])
+        self.assertTrue(context['original_notification']['result_at'])
+        self.assertNotIn('inbox_token', str(context))
+        self.assertNotIn('callback_token', str(context))
+
+    def test_current_github_event_preempts_historical_observation_reminders(self):
+        aid = server.add_activity('SYSTEM', 'old awareness reminder', 'pm')
+        old = server.enqueue(aid, 'pm', 'old awareness reminder', source_actor='SYSTEM',
+                             delivery_key='notification-board-fallback:old')
+        aid = server.add_activity('GITHUB', '#1596 new source review packet', 'pm')
+        new = server.enqueue(aid, 'pm', '#1596 new source review packet', source_actor='GITHUB')
+        self.assertEqual(server.next_queue('pm')['id'], new)
+        self.assertEqual(next(x for x in server.list_queue() if x['id'] == old)['status'], 'queued')
+
+    def test_real_result_settles_only_uninvoked_fallback(self):
+        self.pair()
+        for status in ('queued', 'delivering'):
+            probe = server.probe_actor_route('app_dev')
+            aid = server.add_activity('SYSTEM', 'reminder', 'pm')
+            qid = server.enqueue(aid, 'pm', 'reminder', source_actor='SYSTEM')
+            with server.con() as db:
+                db.execute('UPDATE agent_notifications SET fallback_queue_id=? WHERE action_id=?', (qid, probe['action_id']))
+            if status == 'delivering':
+                server.update_queue(qid, status='delivering')
+            self.callback(probe, 'receipt', 'received')
+            self.callback(probe, 'result', 'wake=automatic; observed')
+            row = next(x for x in server.list_queue() if x['id'] == qid)
+            self.assertEqual(row['status'], 'superseded' if status == 'queued' else 'delivering')
+
+    def test_native_cli_pm_is_not_sent_an_unpaired_external_self_notice(self):
+        with patch.object(server, 'dispatch_event_notifications'):
+            server.persist_event_notifications('CI complete; review needed', event_key='fresh')
+        with server.con() as db:
+            actors = {r['actor_id'] for r in db.execute('SELECT actor_id FROM agent_notifications')}
+        self.assertEqual(actors, {'app_dev', 'cli_dev', 'browser_pm'})
