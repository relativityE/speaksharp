+def stop_owned_workers():
+    """Stop only this foreground board's children; never another actor's Terminal.
+
+    SIGTERM runs the recipient's finally block, including app-server group cleanup.
+    A missed deadline remains an explicit hold; killing only the relay could orphan
+    a potentially executing app-server and must not authorize another writer.
+    """
+    global STOPPING
+    with OWNED_LOCK:
+        STOPPING = True
+        children = list(OWNED_CHILDREN.items())
+    for _, (child, _, _) in children:
+        if child.poll() is None:
+            child.terminate()
+    unresolved = []
+    for pid, (child, actor, session) in children:
+        try:
+            child.wait(timeout=12)
+        except subprocess.TimeoutExpired:
+            unresolved.append(actor)
+            with actor_channels.db() as db:
+                db.execute("UPDATE workers SET status='blocked_transport',error=? WHERE actor=? AND session=? AND pid=?",
+                           ('Foreground worker cleanup unverified; preserve runtime and reconcile before restart', actor, session, pid))
+            continue
+        with OWNED_LOCK:
+            OWNED_CHILDREN.pop(pid, None)
+    return unresolved
