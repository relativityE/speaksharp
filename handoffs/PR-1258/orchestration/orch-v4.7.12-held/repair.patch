+def read_owned_thread(client, ledger, reconnect):
+    """Reconnect a disconnected *read*, before claim/send, to the same saved thread.
+
+    No turn/start or turn/steer can be retried here. Process cleanup must finish
+    before constructing a replacement. Durable uncertain actions block recovery.
+    """
+    if ledger.unresolved():
+        raise QueueUncertain('Unresolved action prevents idle connection recovery')
+    try:
+        thread = client.rpc('thread/read', {'threadId': ledger.thread_id, 'includeTurns': False}).get('thread', {})
+    except (OSError, QueueUncertain):
+        client.close()
+        replacement = reconnect()
+        try:
+            thread = initialize(replacement, ledger)
+            if thread.get('status', {}).get('type') != 'idle':
+                raise RouteError('resumed worker is not idle; no task was sent')
+        except Exception:
+            replacement.close()
+            raise
+        client = replacement
+    if thread.get('id') != ledger.thread_id:
+        raise RouteError('owned thread readback differs; no task was sent')
+    return client, thread
