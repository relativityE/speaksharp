+def retire_unpresented_notice(action_id, actor, session):
+    """Administrative coalescing only; never a receipt or task completion.
+
+    Called only for awareness notices identified by the board. An inbox read or
+    worker claim crosses the delivery boundary and prevents retirement.
+    """
+    with LOCK, db() as c:
+        c.execute('BEGIN IMMEDIATE')
+        if c.execute("SELECT 1 FROM sqlite_master WHERE name='worker_actions'").fetchone():
+            if c.execute('SELECT 1 FROM worker_actions WHERE action_id=?', (action_id,)).fetchone():
+                return False
+        row = c.execute('SELECT state FROM messages WHERE action_id=? AND actor=? AND session=?',
+                        (action_id, actor, session)).fetchone()
+        if row and row['state'] == 'superseded':
+            return True  # Reconcile a prior inbox commit if the board commit was interrupted.
+        return c.execute("UPDATE messages SET state='superseded' WHERE action_id=? AND actor=? AND session=? AND state='pending'",
+                         (action_id, actor, session)).rowcount == 1
+
