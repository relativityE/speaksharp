+def remember_control_checkpoints(rows):
+    """Durable human checkpoints: empty polls and bot chatter cannot erase them.
+
+    This is context only, not the event cursor or action authority. Keep original
+    source timestamps so historical redelivery does not become fresh evidence.
+    """
+    def source_time(row):
+        raw = row.get('at') or row.get('updated_at') or row.get('created_at') or ''
+        try:
+            stamp = datetime.fromisoformat(raw.replace('Z', '+00:00'))
+            if stamp.tzinfo is None:
+                stamp = stamp.replace(tzinfo=timezone.utc)
+            return stamp.timestamp()
+        except (TypeError, ValueError, AttributeError):
+            return 0
+
+    with DB_LOCK, con() as c:
+        saved = c.execute("SELECT value FROM settings WHERE key='control_checkpoint_context'").fetchone()
+        try:
+            previous = json.loads(saved['value']) if saved else []
+        except (ValueError, TypeError):
+            previous = []
+        if not isinstance(previous, list):
+            previous = []
+        merged = {}
+        for row in previous + rows:
+            if not isinstance(row, dict) or not row.get('id') or 'rwt-board-pm:' in str(row.get('body') or ''):
+                continue
+            key = int(row['id'])
+            old = merged.get(key)
+            if old is not None and source_time(old) > source_time(row):
+                continue
+            merged[key] = {'id': key, 'url': row.get('html_url') or row.get('url'),
+                           'at': row.get('updated_at') or row.get('created_at') or row.get('at'),
+                           'body': str(row.get('body') or '')[:12000]}
+        retained = sorted(merged.values(), key=lambda row: (source_time(row), row['id']))[-12:]
+        c.execute("INSERT OR REPLACE INTO settings(key,value) VALUES('control_checkpoint_context',?)",
+                  (json.dumps(retained, ensure_ascii=False),))
+
