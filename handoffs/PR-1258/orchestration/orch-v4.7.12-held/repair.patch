+
+
+class ObservationIncidentTests(ActorChannelTests):
+    def notice(self, action, task='event-observation', session='same-route'):
+        with server.con() as db:
+            db.execute("INSERT INTO agent_notifications(notification_key,handoff_id,actor_id,task_id,action_id,target_transport,target_session_id,head,instruction,status,attempts,accepted_at,created_at,updated_at) VALUES(?,0,'cli_dev',?,?,'codex_app_server',?,'','observation','awaiting_receipt',1,?,?,?)",
+                       (action, task, action, session, server.now(), server.now(), server.now()))
+
+    def test_historical_observation_burst_has_one_route_recovery_per_phase(self):
+        for i in range(20):
+            self.notice(f'github-event:{i}:cli_dev')
+        server.sweep_agent_delivery_stalls(at=time.time() + 1000)
+        server.init_db()
+        self.notice('github-event:later:cli_dev')
+        server.sweep_agent_delivery_stalls(at=time.time() + 2000)
+        with server.con() as db:
+            recovery = db.execute("SELECT count(*) FROM queue WHERE delivery_key LIKE 'notification-%' AND recipient='pm'").fetchone()[0]
+            notices = db.execute("SELECT status,receipt_at,result_at FROM agent_notifications").fetchall()
+        self.assertEqual(recovery, 2)
+        self.assertEqual(len(notices), 21)
+        self.assertTrue(all(r['status'] == 'awaiting_receipt' and not r['receipt_at'] and not r['result_at'] for r in notices))
+
+    def test_other_session_and_actual_task_keep_separate_recovery(self):
+        self.notice('event-a')
+        self.notice('event-b', session='other-route')
+        self.notice('real-task', task='review-task')
+        server.sweep_agent_delivery_stalls(at=time.time() + 1000)
+        with server.con() as db:
+            self.assertEqual(db.execute("SELECT count(*) FROM queue WHERE delivery_key LIKE 'notification-%'").fetchone()[0], 6)
+
+    def test_partial_result_never_settles_other_unacknowledged_delivery(self):
+        self.notice('event-a')
+        self.notice('event-b')
+        server.sweep_agent_delivery_stalls(at=time.time() + 1000)
+        token = server._notification_callback_token('event-a', 'cli_dev', 'same-route')
+        payload = {'action_id': 'event-a', 'actor_id': 'cli_dev', 'session_id': 'same-route', 'evidence': 'seen'}
+        self.assertEqual(server.record_agent_task_callback({**payload, 'stage': 'receipt'}, token)[0], 200)
+        self.assertEqual(server.record_agent_task_callback({**payload, 'stage': 'result'}, token)[0], 200)
+        with server.con() as db:
+            ids = [r[0] for r in db.execute('SELECT DISTINCT fallback_queue_id FROM agent_notifications')]
+            self.assertEqual(len(ids), 1)
+            self.assertEqual(db.execute('SELECT status FROM queue WHERE id=?', (ids[0],)).fetchone()[0], 'queued')
+            self.assertEqual(db.execute("SELECT status FROM agent_notifications WHERE action_id='event-b'").fetchone()[0], 'awaiting_receipt')
+
+    def test_fully_reconciled_incident_can_report_a_later_outage(self):
+        self.notice('event-a')
