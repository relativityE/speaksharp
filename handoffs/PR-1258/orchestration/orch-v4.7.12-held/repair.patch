+            with actor_channels.db() as db:
+                db.execute("UPDATE workers SET status='blocked_transport',error=? WHERE actor=? AND session=? AND pid=?",
+                           ('Foreground worker cleanup unverified; preserve runtime and reconcile before restart', actor, session, pid))
