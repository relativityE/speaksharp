 "newRows": [
  {
   "leg": "J1.a",
   "assertion": "trial-length-thirty-days",
   "what": "On the deployed build, read with the account's own token, the trial started within the signup window and ends exactly 30 days later (product owner, 14 Nov). The DB test checks this only on the original trigger body.",
   "status": "row new"
  },
  {
   "leg": "J1.c",
   "assertion": "short-stop-no-save",
   "what": "A Stop under 5 s saves nothing: no completed sessions row, no history entry (G5).",
   "status": "needs short-Stop fix PR"
  },
  {
   "leg": "J1.d",
   "assertion": "signout-no-unauthorized-read",
   "what": "Around sign-out, no read succeeds without a valid session and no saved data reaches the signed-out page. A 403 denial is a correct answer, not a failure (GAP-04; first seen on the maintained account, so comparability on a fresh account is unproven).",
   "status": "row new"
  },
  {
   "leg": "J1.d",
   "assertion": "signout-no-stale-request",
   "what": "After sign-out completes, the page issues no further authenticated request with the old session (GAP-04). Reported separately from signout-no-unauthorized-read.",
   "status": "row new"
  },
  {
   "leg": "J1.e",
   "assertion": "trial-expired-wall-on-open-session",
   "what": "With the browser still signed in, a reload or navigation after the trial ends lands on the payment page (G3).",
   "status": "needs payment-wall PR"
  },
  {
   "leg": "J1.e",
   "assertion": "trial-expired-payment-wall",
   "what": "A fresh sign-in after expiry lands on the payment page; Practice, History, Progress, PDF export and deep links are not reachable (G3).",
   "status": "needs payment-wall PR"
  },
  {
   "leg": "J1.e",
   "assertion": "trial-expired-server-refuses",
   "what": "On the deployed build, direct calls with the expired account's own token (Start, save, coaching, history read) are refused. Checks the deployed bodies; the logic itself is in DB and contract tests (G1, G2).",
   "status": "needs payment-wall PR"
  },
  {
   "leg": "J1.f",
   "assertion": "account-delete-from-wall",
   "what": "The expired, unpaid user can still delete the account from the wall; account and saved data are gone afterwards.",
   "status": "needs deletion flow confirmed shippable"
  },
  {
   "leg": "J2",
   "assertion": "paid-wall-before-payment",
   "what": "A run-owned expired account sees the wall with a way to pay.",
   "status": "needs payment-wall PR"
  },
  {
   "leg": "J2",
   "assertion": "checkout-opens-for-expired-user",
   "what": "The wall's pay action opens hosted Checkout for the $10 monthly price, bound to this account, with no trial; not completed.",
   "status": "new"
  },
  {
   "leg": "J2",
   "assertion": "abandoned-checkout-stays-walled",
   "what": "Returning from Checkout without paying leaves the account walled and unpaid.",
   "status": "new"
  },
  {
   "leg": "J2",
   "assertion": "deployed-webhook-ready",
   "what": "The deployed webhook rejects an unsigned event and is configured (existing stripe-webhook-readiness).",
   "status": "exists"
  },
  {
   "leg": "J7.d",
   "assertion": "account-delete-during-trial",
   "what": "An in-trial user deletes the account from the Account page; sign-in fails afterwards and run cleanup finds nothing left.",
   "status": "needs deletion flow confirmed shippable"
  },
  {
