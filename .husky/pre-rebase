#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# --- single-owner worktree guard (opt-in; no-op unless SS_AGENT is set) ---
# A rebase rewrites history in place; block it in a worktree/branch the caller does not own.
if [ -n "$SS_AGENT" ]; then
  node scripts/agent-worktree.mjs assert-owner --agent "$SS_AGENT" || {
    echo "❌ [agent-worktree] '$SS_AGENT' does not own this worktree/branch — rebase blocked."
    exit 1
  }
fi
