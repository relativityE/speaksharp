#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# --- single-owner worktree guard (opt-in; no-op unless SS_AGENT is set) ---
if [ -n "$SS_AGENT" ]; then
  node scripts/agent-worktree.mjs assert-owner --agent "$SS_AGENT" || {
    echo "❌ [agent-worktree] '$SS_AGENT' does not own this worktree/branch — push blocked."
    exit 1
  }
fi

echo "[husky] Running pre-push quality checks... 🚀"

# Run the canonical local CI simulation
# This is the single source of truth for build/test health.
pnpm ci:local

if [ $? -ne 0 ]; then
  echo "❌ [husky] Pre-push checks failed. Push aborted. Please fix errors before pushing."
  exit 1
fi

echo "✅ [husky] Pre-push checks passed. Pushing to remote..."
