{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "pnpm build",
    "outputDirectory": "frontend/dist",
    "framework": "vite",
    "installCommand": "pnpm install --frozen-lockfile",
    "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
    "git": {
        "deploymentEnabled": {
            "**": false,
      "main": false,
            "preview/**": true
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/|assets/|models/).*)",
            "destination": "/"
        }
    ],
    "headers": [
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-cache"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin"
                },
                {
                    "key": "Cross-Origin-Embedder-Policy",
                    "value": "credentialless"
                }
            ]
        },
        {
            "source": "/models/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                }
            ]
        },
        {
            "source": "/models/(.*)\\.json",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/json"
                }
            ]
        },
        {
            "source": "/models/(.*)\\.txt",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/models/(.*)\\.(onnx|data|bin|ort)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/octet-stream"
                }
            ]
        },
        {
            "source": "/models/(.*)\\.(js|mjs|cjs)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/javascript; charset=utf-8"
                }
            ]
        },
        {
            "source": "/models/(.*)\\.wasm",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/wasm"
                }
            ]
        },
        {
            "source": "/models/((?:[^/]+/)*[^/.]+)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "text/plain; charset=utf-8"
                }
            ]
        },
        {
            "source": "/models/((?:[^/]+/)*[^/]+\\.(?!(?:json|txt|onnx|data|bin|ort|js|mjs|cjs|wasm)$)[^/.]+)",
            "headers": [
                {
                    "key": "Content-Type",
                    "value": "application/octet-stream"
                }
            ]
        }
    ]
}
