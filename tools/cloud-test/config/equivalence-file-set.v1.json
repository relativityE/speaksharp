 "harness": "every path named in harness/PACKET-MANIFEST.sha256, plus that manifest; the identity carries the CODE/PACKET pins only from a PASSING harness-verified check",
 "excluded": {
  "dirNamesAnywhere": [
   "__pycache__"
  ],
  "dirs": [
   "runner/node_modules",
   "config/history/receipts",
   "config/history/analysis",
   "config/proofs"
  ],
  "files": [
   "config/history/index.json",
   "config/history/owner-counters.json"
  ],
  "fileSuffixes": [
   ".pyc"
  ]
 },
 "symlinks": "excluded trees are pruned by path before descent and never entered, dereferenced, inspected or published; a symlink that is an included path, or is any directory component of an included path, or is any entry in an included directory (scripts, tests, report, config, templates, harness-adapter, harness) makes identity INCOMPLETE; never followed",
 "unexpected": "a regular file outside paths/harness/excluded makes identity INCOMPLETE; the public summary carries only {category: source|config|other, count}, never its path",
 "missing": "a listed path that is absent makes identity INCOMPLETE; listed paths are public repository paths and may be named",
 "selfInclusion": "the two manifest files are hashed as ordinary bytes; the aggregate digest is computed over the canonical (path, sha256) list and is never written into any input file",
 "externalInputs": {
  "rule": "each is recorded as {name, source: env|default, repoRelativePath or 'outside-repo', sha256}; absent or unreadable -> UNKNOWN; package-only identity never claims equal inputs while any is UNKNOWN",
